{
  "info": {
    "name": "User API Tests",
    "description": "Run with the Collection Runner (in order). Needs the server running and MONGODB_URI set. Validation-only requests (400) work without a database.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Root responds",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"body is Hello, World!\", () => pm.expect(pm.response.text()).to.eql(\"Hello, World!\"));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/",
          "host": [
            "{{baseUrl}}"
          ],
          "path": []
        }
      }
    },
    {
      "name": "Create user - valid (email normalized)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set(\"email\", \"User.\" + Date.now() + \"@Example.com\");"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"status is 201\", () => pm.response.to.have.status(201));",
              "const u = pm.response.json();",
              "pm.test(\"name trimmed\", () => pm.expect(u.name).to.eql(\"Somchai\"));",
              "pm.test(\"email lower-cased and trimmed\", () => pm.expect(u.email).to.eql(pm.collectionVariables.get(\"email\").toLowerCase()));",
              "pm.test(\"age kept\", () => pm.expect(u.age).to.eql(20));",
              "pm.test(\"has _id\", () => pm.expect(u._id).to.be.a(\"string\"));",
              "pm.collectionVariables.set(\"userId\", u._id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"  Somchai \",\n  \"email\": \" {{email}} \",\n  \"age\": 20\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/users",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "users"
          ]
        }
      }
    },
